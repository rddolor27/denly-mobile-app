# Copy to .env (git-ignored) and fill in. Every EXPO_PUBLIC_* value is compiled into the app
# bundle and is therefore public: never put a secret here.

# Base URL of the Denly API (denly-backend), no trailing slash.
# Development builds may use http for a local backend; release builds require https.
# On a physical iPhone use your computer's LAN IP, not localhost.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
